{
  "name": "incident-management-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "check": "node --check src/server.js && node --check src/db.js"
  },
  "dependencies": {
    "connect-pg-simple": "10.0.0",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "express-session": "1.18.1",
    "pg": "8.13.1"
  },
  "description": "Ubuntu 24.04 EC2 native incident management teaching lab (no Docker)",
  "engines": {
    "node": ">=22 <27"
  }
}
