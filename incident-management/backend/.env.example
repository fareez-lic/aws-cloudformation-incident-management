# Example only. The setup script creates real secrets in backend/.env.
PORT=5000
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=incidentdb
DB_USER=incident_user
DB_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=GENERATE_A_RANDOM_HEX_SALT
ADMIN_PASSWORD_HASH=GENERATE_A_SCRYPT_HASH
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# Set true only after HTTPS is configured.
SESSION_COOKIE_SECURE=false
